{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "App version in config.yaml follows the image",
      "managerFilePatterns": ["/^yuvomi/config\\.yaml$/"],
      "matchStrings": ["version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "ghcr.io/ulsklyc/yuvomi",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["ghcr.io/ulsklyc/yuvomi"],
      "groupName": "Yuvomi"
    },
    {
      "description": "Action updates merge once the required checks on main pass. The Yuvomi bump stays manual.",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
