{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Yuvomi base image in the Dockerfile",
      "managerFilePatterns": ["/^yuvomi/Dockerfile$/"],
      "matchStrings": ["ghcr\\.io/ulsklyc/yuvomi:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "ghcr.io/ulsklyc/yuvomi",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "App version in config.yaml follows the image",
      "managerFilePatterns": ["/^yuvomi/config\\.yaml$/"],
      "matchStrings": ["version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "ghcr.io/ulsklyc/yuvomi",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["ghcr.io/ulsklyc/yuvomi"],
      "groupName": "Yuvomi"
    }
  ]
}
